        "def build_lstm(seq_len, units=50, n_layers=1, dropout=0.0, lr=1e-3):\n",
        "    \"\"\"Stacked LSTM (n_layers) with optional dropout, followed by a Dense output neuron.\"\"\"\n",
        "    model = Sequential([Input(shape=(seq_len, 1))])\n",
        "    for i in range(n_layers):\n",
        "        model.add(LSTM(units, return_sequences=(i < n_layers - 1)))\n",
        "        if dropout > 0:\n",
        "            model.add(Dropout(dropout))\n",
        "    model.add(Dense(1))\n",
        "    model.compile(optimizer=Adam(learning_rate=lr), loss='mse')\n",
        "    return model\n",
