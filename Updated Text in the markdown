      "cell_type": "code",
      "source": [
        "# Lag sweep\n",
        "y_tr_diff = y_tr.diff().dropna()\n",
        "\n",
        "rows = []\n",
        "for p in range(1, MAX_P + 1):\n",
        "    # --- AR on the original series ---\n",
        "    res_o = fit_ar(y_tr, p, hold_back=MAX_P)\n",
        "    pred_o = ar_one_step(res_o, y_tr, y_val, p)\n",
        "    m_o = evaluate(y_val, pred_o, 'AR (original)')\n",
        "    m_o.update({'p': p, 'AIC': res_o.aic, 'BIC': res_o.bic})\n",
        "    rows.append(m_o)\n",
        "\n",
        "    # --- AR on the differenced series ---\n",
        "    res_d = fit_ar(y_tr_diff, p, hold_back=MAX_P)\n",
        "    pred_d = ar_diff_one_step(res_d, y_tr, y_val, p)\n",
        "    m_d = evaluate(y_val, pred_d, 'AR (differenced)')\n",
        "    m_d.update({'p': p, 'AIC': res_d.aic, 'BIC': res_d.bic})\n",
        "    rows.append(m_d)\n",
        "\n",
        "ar_sweep = pd.DataFrame(rows)[['Model', 'p', 'RMSE (°C)', 'MAE (°C)', 'MAPE (%)', 'AIC', 'BIC']]\n",
        "\n",
