        "# Persistence baseline\n",
        "def persistence_forecast(history, target):\n",
        "    \"\"\"Naive one-step-ahead forecast: each day's prediction is the previous day's actual value.\"\"\"\n",
        "    combined = pd.concat([history, target])\n",
        "    return combined.shift(1).loc[target.index]\n",
        "\n",
        "pers_val  = persistence_forecast(y_tr, y_val)\n",
        "pers_test = persistence_forecast(y_full_train, y_test)\n",
        "\n",
        "baseline_table = pd.DataFrame([\n",
        "    evaluate(y_val,  pers_val,  'Persistence (validation)'),\n",
        "    evaluate(y_test, pers_test, 'Persistence (test)'),\n",
        "]).round(3)\n",
        "display(baseline_table)"
