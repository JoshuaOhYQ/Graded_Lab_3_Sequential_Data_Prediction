        "def run_lstm(cfg, history, target, seed):\n",
        "    \"\"\"Train one LSTM with a given config and seed; return predictions (°C) and training info.\"\"\"\n",
        "    tf.keras.utils.set_random_seed(seed)\n",
        "    X_tr, y_tr_s, X_ev, _, scaler = prepare_data(history, target, cfg['seq_len'])\n",
        "\n",
        "    model = build_lstm(cfg['seq_len'], cfg['units'], cfg['n_layers'], cfg['dropout'], cfg['lr'])\n",
        "    early_stop = EarlyStopping(monitor='val_loss', patience=cfg.get('patience', 20), restore_best_weights=True)\n",
        "\n",
        "    t0 = time.perf_counter()\n",
        "    hist = model.fit(X_tr, y_tr_s, epochs=cfg.get('epochs', 300), batch_size=cfg['batch_size'],\n",
        "                     validation_split=0.1, callbacks=[early_stop], verbose=0)\n",
        "    train_time = time.perf_counter() - t0\n",
