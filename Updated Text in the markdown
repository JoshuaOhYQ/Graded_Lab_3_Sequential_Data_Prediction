        "# Residual diagnostics using Ljung-Box and visualization\n",
        "from statsmodels.stats.diagnostic import acorr_ljungbox\n",
        "\n",
        "resid = pd.Series(ar_final.resid, index=y_full_train.index[BEST_P_ORIG:])\n",
        "\n",
        "# Ljung-Box test: H0 = residuals are uncorrelated (white noise)\n",
        "lb = acorr_ljungbox(resid, lags=[14, 21, 30], model_df=BEST_P_ORIG, return_df=True)\n",
        "lb.index.name = 'Lags tested'\n",
        "lb['White noise at 5%?'] = np.where(lb['lb_pvalue'] > 0.05, 'Yes', 'No')\n",
        "display(lb.round(4))\n",
        "\n",
        "# Diagnostic plots\n",
        "fig, axes = plt.subplots(1, 3, figsize=(16, 4))\n",
        "\n",
        "axes[0].plot(resid.index, resid, linewidth=0.8)\n",
        "axes[0].axhline(0, color='black', linewidth=1)\n",
        "axes[0].set_title('Residuals over time')\n",
        "axes[0].set_xlabel('Date')\n",
        "axes[0].set_ylabel('Residual (°C)')\n",
        "\n",
        "axes[1].hist(resid, bins=40, edgecolor='black', alpha=0.7)\n",
        "axes[1].set_title('Residual distribution')\n",
        "axes[1].set_xlabel('Residual (°C)')\n",
        "axes[1].set_ylabel('Frequency')\n",
        "\n",
        "plot_acf(resid, ax=axes[2], lags=30)\n",
        "axes[2].set_title('ACF of residuals')\n",
        "axes[2].set_xlabel('Lag (days)')\n",
        "\n",
        "plt.suptitle(f'Figure 8. Residual diagnostics for AR({BEST_P_ORIG}) fitted on the full training data')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(f\"Residual mean: {resid.mean():.4f} °C | Residual std: {resid.std():.4f} °C\")"
