        "# Testing whether it is stationary using ADF\n",
        "def adf_report(series, name):\n",
        "    \"\"\"Run the Augmented Dickey-Fuller test and return the key results as a dict.\"\"\"\n",
        "    stat, pvalue, usedlag, nobs, crit, _ = adfuller(series.dropna(), autolag='AIC', result_object=False)\n",
        "    return {\n",
        "        'Series': name,\n",
        "        'ADF statistic': round(stat, 3),\n",
        "        'p-value': round(pvalue, 4),\n",
        "        'Critical value (5%)': round(crit['5%'], 3),\n",
        "        'Stationary at 5%?': 'Yes' if pvalue < 0.05 else 'No',\n",
        "    }\n",
        "\n",
        "y_train = train_df['meantemp']\n",
        "\n",
        "adf_table = pd.DataFrame([\n",
        "    adf_report(y_train, 'meantemp (original)'),\n",
        "    adf_report(y_train.diff(), 'meantemp (first difference)'),\n",
        "])\n",
        "display(adf_table)"
