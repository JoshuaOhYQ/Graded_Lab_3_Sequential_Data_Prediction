        "def make_windows(series_scaled, start_idx, seq_len):\n",
        "    \"\"\"\n",
        "    Build (X, y) from a 1-D scaled array.\n",
        "    X[i] = series[t-seq_len : t], y[i] = series[t], for t = start_idx ... end.\n",
        "    \"\"\"\n",
        "    X, y = [], []\n",
        "    for t in range(start_idx, len(series_scaled)):\n",
        "        X.append(series_scaled[t - seq_len:t])\n",
        "        y.append(series_scaled[t])\n",
        "    X = np.array(X).reshape(-1, seq_len, 1)     # (samples, time steps, features)\n",
        "    return X, np.array(y)\n",
        "\n",
        "def prepare_data(history, target, seq_len):\n",
        "    \"\"\"\n",
        "    Scale with a MinMax scaler fitted on `history` only, then build training windows\n",
        "    (from history) and evaluation windows (for every date in target, with warm-up).\n",
        "    \"\"\"\n",
        "    scaler = MinMaxScaler(feature_range=(0, 1))\n",
        "    hist_s = scaler.fit_transform(history.to_numpy().reshape(-1, 1)).flatten()\n",
