        "    info = {'epochs': len(hist.history['loss']), 'train_time_s': train_time,\n",
        "            'params': model.count_params(), 'history': hist.history}\n",
        "    return pred, info, model\n",
        "\n",
        "def evaluate_config(cfg, history, target, label, seeds=SEEDS):\n",
        "    \"\"\"Train a config over several seeds; return a mean ± std summary, per-seed results and predictions.\"\"\"\n",
        "    per_seed, preds, infos = [], [], []\n",
